# Optional future browser connection. Never place a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# حقل التحقق من Google Search Console (اختياري حتى تُصدر رمز الملكية من Google).
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# النطاق الرسمي. يستخدم الرابط الاحتياطي anamuslim-hgz.vercel.app عند تركه فارغًا.
NEXT_PUBLIC_SITE_URL=https://anamuslim-hgz.vercel.app

# Only needed by the manually invoked data-import script, never exposed to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
